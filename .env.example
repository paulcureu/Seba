# Opțional — fără ele site-ul funcționează, iar comenzile apar doar în Vercel → Logs.
# Cheie de la https://resend.com pentru a primi comenzile, rezervările și mesajele pe email.
RESEND_API_KEY=
# Unde ajung emailurile (poți pune mai multe, separate prin virgulă)
ORDER_EMAIL_TO=contact@pizzaseba.ro
# Expeditorul (după ce verifici domeniul în Resend), ex: Pizza Seba <comenzi@pizzaseba.ro>
ORDER_EMAIL_FROM=
